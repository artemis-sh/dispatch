{
  "name": "dispatch",
  "version": "1.0.0",
  "description": "Durable execution platform for OpenCode agents in Kubernetes sandboxes",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node dist/migrate.js",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.34.5",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "10.34.5",
      "onFail": "download"
    }
  },
  "type": "module",
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^1.6.0",
    "@kubernetes/client-node": "^2.0.0",
    "@opencode-ai/sdk": "^1.18.18",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.2",
    "pg": "^8.23.0",
    "prom-client": "^15.1.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testcontainers/k3s": "^12.1.0",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.10",
    "testcontainers": "12.1.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
